# Copy to `.env` (repo root) and fill in. Never commit `.env`.

# --- PostgreSQL (local) ---
# Create the database first:  CREATE DATABASE coach;
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/coach?schema=public"

# --- API ---
API_PORT=4000
# Comma-separated list of allowed browser origins (only needed if the web app calls the API cross-origin)
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Anyone can create an account on the /register page. Set to false to close sign-ups (then use `pnpm db:seed`).
ALLOW_REGISTRATION=true

# --- Seed user (used only by `pnpm db:seed`) ---
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=choose-a-strong-password
SEED_USER_NAME=Your Name
SEED_USER_TIMEZONE=Asia/Tehran

# --- Web ---
# Where the Next.js server proxies /api/* to
API_INTERNAL_URL=http://localhost:4000

# --- Files ---
# Uploaded teacher files. Default: <repo>/storage
STORAGE_DIR=

# --- AI ---
# Without a key everything works except the AI features: reading teacher notes, AI explanations,
# "Fill with AI" and marking written answers.
OPENAI_API_KEY=
# Optional: proxy / gateway (include the /v1 part). Leave empty for api.openai.com.
OPENAI_BASE_URL=
# The model that reads teacher material. Change it here when you want a different one.
AI_MODEL_PARSE=gpt-4o-mini
# Safety ceiling on AI calls per learner per day.
AI_DAILY_CALL_LIMIT=100
# Set to `mock` to try the whole flow with a tiny fake model (no key, no network).
AI_PROVIDER=
